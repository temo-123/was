APP_NAME="Climbing Gym"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://climbing.loc

APP_LOCALE=ka
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Tbilisi

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=climbing_gym
DB_USERNAME=climbing
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=climbing.loc,was.loc,localhost,127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Shown on /terms and /privacy
LEGAL_COMPANY="Climbing Gym LLC"
LEGAL_ADDRESS="Tbilisi, Georgia"
LEGAL_EMAIL=info@climbing.loc
LEGAL_PHONE="+995 5XX XX XX XX"

# Sport club check-in: address phones use to open the QR link, e.g. http://192.168.1.10
# (empty = auto: the panel's address, with "localhost" replaced by the detected LAN IP)
CLUB_CHECKIN_URL=
CLUB_QR_ROTATION=30

# Club meeting QR screen: Wi-Fi the phones join (empty name = not shown). Encryption: WPA, WEP or nopass.
CLUB_WIFI_NAME=
CLUB_WIFI_PASSWORD=
CLUB_WIFI_ENCRYPTION=WPA
CLUB_WIFI_HIDDEN=false
CLUB_WIFI_SHOW_PASSWORD=true
